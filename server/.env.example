# Copy this file to .env and fill it in. NEVER commit .env.
PORT=4000

# Comma-separated list of frontend addresses allowed to call this API.
# Local dev:  http://localhost:5173
# Deployed:   add your Vercel URL, e.g. http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# Your Convex deployment URL (looks like https://something-123.convex.cloud).
# Keep it secret: it lives on the server only and must never go in the frontend.
# If empty, the server falls back to in-memory storage (data is lost on restart).
CONVEX_URL=
